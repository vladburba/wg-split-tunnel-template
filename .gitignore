# WireGuard configs (содержат приватные ключи!)
*.conf
clients/
# Исключение: services.conf — конструктор сервисов, без секретов
!services.conf

# QR-коды (содержат полный профиль с приватным ключом)
*.png
# Кроме примера для документации с фейковыми ключами
!docs/*.png

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# IDE / редакторы
.vscode/
.idea/
*.swp

# macOS
.DS_Store

# Логи
*.log
